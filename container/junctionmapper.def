Bootstrap: docker
From: python:3.11.18-slim
# Base image: pinned to the patch version (3.11.18), not by digest.
#
# Reproducibility:
# - Every DIRECT dependency is pinned exactly. A rebuild installs the same direct set.
# - Transitive deps (zarr's, dask, numcodecs, bioio-base, ...) are NOT pinned and can drift.
# - Each run records the versions it used (provenance.library_versions, code_identity).
#   Use that, not this file, to tie a figure to its environment.
#
# GPU: torch wheels bundle CUDA (13.2). Run with `apptainer --nv` or APPTAINER_NV=1.
#   Without it, torch silently falls back to CPU: a very slow run, not an error.

%labels
    Name junctionmapper
    Description Runtime for the junctionmapper library, test suite and Cellpose-SAM segmentation

%post
    set -eux

    # Pure pip only; no apt-get.
    # - On CRC there is no fakeroot binary and this user is not in /etc/subuid.
    # - apt then fails with "setgroups (1: Operation not permitted)".

    pip install --no-cache-dir "pip==26.3"

    # Runtime deps: exact pins, read back out of the built image.
    # - Measured numbers depend on numpy, scipy, scikit-image and pandas versions.
    # - pyproject.toml keeps `>=` floors: it states what is supported; this file, what is run.
    pip install --no-cache-dir \
        "numpy==2.4.6" \
        "scipy==1.17.1" \
        "scikit-image==0.26.0" \
        "pandas==3.1.1" \
        "pyarrow==26.0.1" \
        "pydantic==2.14.3" \
        "jinja2==3.1.6" \
        "matplotlib==3.11.2" \
        "typer==0.27.3" \
        "pyyaml==6.0.3" \
        "bioio==3.6.0" \
        "bioio-ome-tiff==1.4.1" \
        "bioio-ome-zarr==3.8.1" \
        "tifffile==2026.3.3" \
        "pillow==13.0.0"

    # Test tooling. zarr is declared here because the reader and CLI tests build real OME-Zarr
    # stores; it is not left as a transitive dep of bioio-ome-zarr.
    pip install --no-cache-dir "pytest==9.2.0" "pytest-cov==7.1.0" "zarr==3.1.6"

    # Cellpose-SAM (cellpose 4.x, model `cpsam`) and torch, pinned exactly.
    # - Segmentation decides which pixels are a cell, so every downstream number depends on it.
    # - torch/torchvision: the versions pip resolved for this cellpose.
    # - One image, not a separate segmentation image: two defs would mean two copies of the
    #   runtime pins, and drift would put labels and measurements on different library versions.
    #   The cost: torch's ~3 GB CUDA wheel is in every image, test runs included.
    pip install --no-cache-dir \
        "cellpose==4.2.1.1" \
        "torch==2.15.0" \
        "torchvision==0.29.2"

%environment
    export PYTHONPATH=/project/src:${PYTHONPATH}
    export MPLBACKEND=Agg
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec "$@"

%test
    python -c "import numpy, scipy, skimage, pandas, pydantic, jinja2, matplotlib, typer, yaml, tifffile, PIL; print('core imports OK')"
    python -c "import bioio; print('bioio OK')"
    python -c "import pytest; print('pytest', pytest.__version__)"
    python -c "import zarr; print('zarr', zarr.__version__)"
    python -c "import torch; print('torch', torch.__version__, '| cuda built:', torch.version.cuda)"
    python -c "import cellpose; print('cellpose', cellpose.version)"
